# -------------------
# OCR Utilities
# -------------------
def ocr_image_from_url(image_url):
    """Perform OCR on image from URL and return text and PIL Image."""
    try:
        response = requests.get(image_url, timeout=10)
        img = Image.open(BytesIO(response.content))
        # Convert palette images with transparency to RGBA
        if img.mode == "P" and "transparency" in img.info:
            img = img.convert("RGBA")
        else:
            img = img.convert("RGB")
        text = pytesseract.image_to_string(img)
        return text.lower(), img
    except Exception as e:
        print(f"OCR failed for {image_url}: {e}")
        return "", None

def contains_nutrition_info(text):
    """Check if OCR text contains nutrition information."""
    keywords = ["nutrition", "calories"]
    return any(k in text for k in keywords)

# -------------------
# Load JSONL Products
# -------------------
def load_products(jsonl_path):
    """Yield products from a JSONL file."""
    with open(jsonl_path, "r", encoding="utf-8") as f:
        for line in f:
            yield json.loads(line.strip())

# -------------------
# AWS Bedrock Functions
# -------------------
def generate_json_image_conversation(bedrock_client, model_id, input_text, input_images, tool_list):
    """Send images to Claude for nutrition info extraction."""
    messages = [{
        "role": "user",
        "content": [
            {"text": input_text},
            {"text": "Please use the summarize_nutrition_info tool to extract nutrition information from the image in JSON format."}
        ]
    }]
    for img in input_images:
        buffered = BytesIO()
        img.save(buffered, format="PNG")
        raw_image = buffered.getvalue()
        messages[0]['content'].append({
            "image": {"format": "png", "source": {"bytes": raw_image}}
        })

    response = bedrock_client.converse(
        modelId=model_id,
        messages=messages,
        inferenceConfig={"maxTokens": 3000, "temperature": 0},
        toolConfig={
            "tools": tool_list,
            "toolChoice": {"tool": {"name": "summarize_nutrition_info"}}
        }
    )
    return response

# -------------------
# Process One Product
# -------------------
def process_product(product, bedrock_client, model_id, tool_list, input_text_image):
    """Detect nutrition image and get nutrition info from Claude."""
    images = [v for k, v in product.items() if k.startswith("image_url")]
    candidate_images = []

    for url in images:
        ocr_text, img = ocr_image_from_url(url)
        if contains_nutrition_info(ocr_text) and img:
            print(".             found nutrition information in "+ str(url))
            candidate_images.append(img)

    if candidate_images:
        print(".               sending product to claude")
        response = generate_json_image_conversation(
            bedrock_client,
            model_id,
            input_text_image,
            candidate_images,
            tool_list
        )
        return response
    else:
        print(f"UPC {product.get('universal_product_code')}: No nutrition panel detected.")
        return None

# -------------------
# Merge
# -------------------
def merge_nutrition(original_product, nutrition_dict):
    """
    Take the original product JSON, remove image fields,
    and store Claude's nutrition output under 'Claude_Nutrition_facts'.
    """
    # Remove image fields
    cleaned_product = {
        k: v for k, v in original_product.items()
        if k == "product_name"
    }
    
    # Store Claude's full nutrition dictionary under a new key
    cleaned_product["Nutrition_facts"] = nutrition_dict
    
    return cleaned_product


