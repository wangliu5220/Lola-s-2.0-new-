{
  "manifest_version": 3,
  "name": "Walmart Box Inserter",
  "version": "1.0",
  "description": "Inserts a box into the Walmart website when a button is pressed.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Insert Box"
  },
  "content_scripts": [
    {
      "matches": ["*://www.walmart.com/*"],
      "js": ["content.js"]
    }
  ]
}
