CACHE_FILE = "Team_M/.nutrition_cache.json"  # Don't change

def normalize_upc(upc):
    """Ensure UPCs are consistent strings (strip spaces, drop .0, etc)."""
    if upc is None:
        return None
    upc_str = str(upc).strip()
    if upc_str.endswith(".0"):
        upc_str = upc_str[:-2]
    return upc_str


def load_cache():
    """Load the cache from disk."""
    if os.path.exists(CACHE_FILE):
        with open(CACHE_FILE, "r", encoding="utf-8") as f:
            try:
                cache = json.load(f)
                print(f"Loaded {len(cache)} cached products from {CACHE_FILE}")
                return cache
            except json.JSONDecodeError:
                print(" Cache file corrupted, starting fresh.")
                return {}
    return {}


def save_to_cache(upc, record):
    """Save one product to the cache (by normalized UPC)."""
    upc = normalize_upc(upc)
    if not upc:
        print("⚠️ Missing UPC, skipping cache save.")
        return
    CACHE[upc] = record
    with open(CACHE_FILE, "w", encoding="utf-8") as f:
        json.dump(CACHE, f, ensure_ascii=False, indent=2)


# Initialize global cache once
CACHE = load_cache()


def contains_nutrition_info(text):
    keywords = ["total carbohydrate",
                "includes added sugars", 
                "total sugars", 
                "saturated fat", 
                "polyunsaturated fat",
                "monounsaturated fat", 
                "cholesterol", 
                "calcium", 
                "iron",
                "potassium"
                ]
    return any(k in text.lower() for k in keywords)

