import json
#Combine data from Part 1 and Part 2 to add url for extension.
part2_response = "Team_M/Data/beverages/part2_output.jsonl"
part1_result = "Team_M/Data/beverages/part1_output.jsonl"
output_path = "Team_M/Data/beverages/final_response.jsonl"

# Load result_from_1.jsonl into a lookup dictionary {upc: image_url_1}
upc_to_image = {}
with open(part1_result, "r") as f:
    for line in f:
        try:
            data = json.loads(line)
            upc = data.get("universal_product_code")
            image_url = data.get("image_url_1")
            if upc and image_url:
                upc_to_image[upc] = image_url
        except json.JSONDecodeError:
            continue

# Merge into AI_Response.jsonl
with open(part2_response, "r") as fin, open(output_path, "w") as fout:
    for line in fin:
        try:
            record = json.loads(line)
            upc = record.get("universal_product_code")
            if upc in upc_to_image:
                record["image_url"] = upc_to_image[upc]
            json.dump(record, fout)
            fout.write("\n")
        except json.JSONDecodeError:
            continue

print("✅ Merge complete! Output saved to:", output_path)
