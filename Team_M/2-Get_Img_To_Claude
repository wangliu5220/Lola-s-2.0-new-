def load_products(jsonl_path):
    with open(jsonl_path, "r", encoding="utf-8") as f:
        for line in f:
            yield json.loads(line.strip())



def ocr_and_preprocess(image_url):
    MAX_SIZE = 5 * 1024 * 1024  # 5 MB
    MAX_DIMENSION = 8000        # max width or height in pixels
    try:
        response = requests.get(image_url, timeout=10)
        img = Image.open(BytesIO(response.content))

        if img.mode == "P" and "transparency" in img.info:
            img = img.convert("RGBA")
        else:
            img = img.convert("RGB")
        
        w, h = img.size
        if w > MAX_DIMENSION or h > MAX_DIMENSION:
            scale = MAX_DIMENSION / max(w, h)
            new_size = (int(w * scale), int(h * scale))
            img = img.resize(new_size, Image.LANCZOS)
            print(f"🖼️ Resized image to {new_size} for OCR")

        text = pytesseract.image_to_string(img).lower()
        img_bw = img.convert("L")

        buffer = io.BytesIO()
        quality = 95
        img_bw.save(buffer, format="JPEG", quality=quality)
        while buffer.tell() > MAX_SIZE and quality > 10:
            buffer = io.BytesIO()
            quality -= 10
            img_bw.save(buffer, format="JPEG", quality=quality)
        buffer.seek(0)
    
        return text, Image.open(buffer)

    except Exception as e:
        print(f"OCR failed for {image_url}: {e}")
        return "", None

def generate_json_image_conversation(bedrock_client, model_id, input_text, input_images, tool_list):
    messages = [{
        "role": "user",
        "content": [
            {"text": input_text},
            {"text": "Please use the summarize_nutrition_info tool to extract nutrition information from the image in JSON format."}
        ]
    }]
    for img in input_images:
        buffered = BytesIO()
        img.save(buffered, format="PNG")
        raw_image = buffered.getvalue()
        messages[0]['content'].append({
            "image": {"format": "png", "source": {"bytes": raw_image}}
        })

    response = bedrock_client.converse(
        modelId=model_id,
        messages=messages,
        inferenceConfig={"maxTokens": 3000, "temperature": 0},
        toolConfig={
            "tools": tool_list,
            "toolChoice": {"tool": {"name": "summarize_nutrition_info"}}
        }
    )
    return response
def process_product(product, bedrock_client, model_id, tool_list, input_text_image):
    url = product.get("product_URL")
    if not url:
        print("No product URL found, skipping product")
        return None

    upc = normalize_upc(product.get("universal_product_code"))
    if upc and upc in CACHE:
        print(f".             Using cached nutrition info for UPC {upc}")
        return CACHE[upc]
    
    images = [v for k, v in product.items() if k.startswith("image_url")]
    candidate_images = []

    # Check for nutrition panels
    for img_url in images:
        ocr_text, processed_img = ocr_and_preprocess(img_url)
        if contains_nutrition_info(ocr_text) and processed_img:
            print(".             found nutrition information in " + str(img_url))
            candidate_images.append(processed_img)

    # Fallback: if no nutrition panel found, use all processed images
    if not candidate_images:
        print(f"{url}: No nutrition panel detected. Using all available images instead.")
        for img_url in images:
            _, processed_img = ocr_and_preprocess(img_url)
            if processed_img:
                candidate_images.append(processed_img)

    if candidate_images:
        print(".               sending product to claude")
        prompt_text = f"Product name: {product.get('product_name', 'Unknown')}\n" + input_text_image
        
        response = generate_json_image_conversation(
            bedrock_client,
            model_id,
            prompt_text,
            candidate_images,
            tool_list
        )
        try:
            content_blocks = response['output']['message']['content']
            content_block = next((b for b in content_blocks if 'toolUse' in b), None)
            if content_block:
                nutrition_info = content_block['toolUse']['input']
                final_product = merge_nutrition(product, nutrition_info)
                save_to_cache(upc, final_product)
                return final_product   # return merged product directly
        except Exception as e:
            print(f"    Error parsing Bedrock response for {url}: {e}")
            return None

    # If we reach here, no usable images
    return None

def merge_nutrition(original_product, nutrition_dict):
    cleaned_product = {
        k: v for k, v in original_product.items()
        if k in ["product_name", "snap_eligible", "universal_product_code", "price", "product_URL", "search_query", "avg_rating"]
    }
    cleaned_product["Nutrition_facts"] = nutrition_dict
    return cleaned_product

