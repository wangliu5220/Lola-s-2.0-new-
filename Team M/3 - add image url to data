import json

# File paths
ai_response_path = "Team M/AI_Response.jsonl"
result_path = "Team M/result_from_1.jsonl"
output_path = "Team M/final_response.jsonl"

# Load result_from_1.jsonl into a lookup dictionary {upc: image_url_1}
upc_to_image = {}
with open(result_path, "r") as f:
    for line in f:
        try:
            data = json.loads(line)
            upc = data.get("universal_product_code")
            image_url = data.get("image_url_1")
            if upc and image_url:
                upc_to_image[upc] = image_url
        except json.JSONDecodeError:
            continue

# Merge into AI_Response.jsonl
with open(ai_response_path, "r") as fin, open(output_path, "w") as fout:
    for line in fin:
        try:
            record = json.loads(line)
            upc = record.get("universal_product_code")
            if upc in upc_to_image:
                record["image_url"] = upc_to_image[upc]
            json.dump(record, fout)
            fout.write("\n")
        except json.JSONDecodeError:
            continue

print("✅ Merge complete! Output saved to:", output_path)
